{
  "name": "soltape",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "build:native": "pnpm --filter @soltape/decoder build:native",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path packages/decoder/native/Cargo.toml --no-fail-fast",
    "start": "node apps/service/dist/main.js",
    "dev": "pnpm build && node apps/service/dist/main.js",
    "test:integration": "vitest run --project integration",
    "record": "pnpm build && node apps/replay/dist/main.js record",
    "fixtures:check": "pnpm build && node apps/replay/dist/main.js check",
    "replay": "pnpm build && node apps/replay/dist/main.js serve",
    "bench": "pnpm build && node bench/dist/run.js",
    "bench:decoder": "pnpm build && node bench/dist/decoder.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "smoke": "./scripts/compose-smoke.sh",
    "bench:fanout": "pnpm build && node bench/dist/fanout.js",
    "bench:history": "pnpm build && node bench/dist/history.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
